# Backend environment variables
# Copy this file to .env and fill in your values

# ── WhatsApp Business Cloud API ───────────────────────────────────────────────
# Your permanent (system user) access token from Meta Developer portal
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# The Phone Number ID (not the phone number itself) from Meta Developer portal
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Graph API version
WHATSAPP_API_VERSION=v19.0

# A secret string you choose; must match what you enter in Meta's webhook config
WEBHOOK_VERIFY_TOKEN=my_super_secret_verify_token

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# URL of the frontend (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
